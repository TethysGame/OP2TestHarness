// harness.dll's version resource: the file version (from VERSION, through the build's version.h) and a description.
#include "version.h"

1 VERSIONINFO
FILEVERSION OP2H_VERSION_NUM
PRODUCTVERSION 0, 0, 0, 0
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS 0x40004   // VOS_NT_WINDOWS32
FILETYPE 2       // VFT_DLL
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "OP2TestHarness"
      VALUE "FileVersion", OP2H_VERSION_STR
    END
  END
  // Explorer finds the strings through this (without it the description shows blank).
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
